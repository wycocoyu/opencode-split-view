+
+  // Open session B in split view (1 -> 2 panes: Left = A, Right = B)
+  const rowB = sidebar.locator('[data-slot="session-sidebar-row-wrapper"]').filter({
+    has: page.locator(`[data-session-id="${b.id}"]`),
